<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar icon of every Sinkly notification = the Sinkly logo mark, copied
     1:1 from lib/core/widgets/sinkly_logo_mark_painter.dart (final frame, same
     200-unit design space). Android only uses the alpha of this icon, so the
     logo is white and its navy keyhole becomes a cut-out (evenOdd). The sky
     circle around it comes from Notification.Builder.setColor. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="150"
    android:viewportHeight="150">
    <!-- Crop the 200-unit tile to the glyph (x 34…170, y 30…166). -->
    <group
        android:translateX="-27"
        android:translateY="-23">
        <!-- Shackle + faucet spout, resting open: −10° around the left leg. -->
        <group
            android:pivotX="72"
            android:pivotY="98"
            android:rotation="-10">
            <path
                android:pathData="M72,100L72,70A28,28 0,0 1,128 70L128,84"
                android:strokeWidth="15"
                android:strokeColor="#FFFFFFFF"
                android:strokeLineCap="round" />
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M123.5,82L132.5,82A4.5,4.5 0,0 1,132.5 91L123.5,91A4.5,4.5 0,0 1,123.5 82Z" />
        </group>
        <!-- Basin bowl with the keyhole cut out. -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M54,106L146,106C146,146 126,166 100,166C74,166 54,146 54,106ZM96,134.34A7.5,7.5 0,1 1,104 134.34L106.5,147L93.5,147Z" />
        <!-- Rim -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M52,96L148,96A8,8 0,0 1,148 112L52,112A8,8 0,0 1,52 96Z" />
        <!-- Sparkles -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M158,40C160.16,49.84 160.16,49.84 170,52C160.16,54.16 160.16,54.16 158,64C155.84,54.16 155.84,54.16 146,52C155.84,49.84 155.84,49.84 158,40Z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M40,64C41.08,68.92 41.08,68.92 46,70C41.08,71.08 41.08,71.08 40,76C38.92,71.08 38.92,71.08 34,70C38.92,68.92 38.92,68.92 40,64Z" />
    </group>
</vector>
